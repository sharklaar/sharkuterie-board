{
  "name": "kitchen-ops",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-22",
  "vars": {
    "ACCESS_ISSUER": "https://restless-bush-59bb.cloudflareaccess.com",
    "ACCESS_AUD": "969e52275c70e9aaa94e5429da52822b0e6fdf153f440e556cdaac3a795377eb"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchen-ops",
      "database_id": "2bb920cd-af92-404a-8699-004ca4fc65c1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "kitchen-ops-recipe-images"
    }
  ]
}
